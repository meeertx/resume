# Copy this file to .env (gitignored — never commit real keys) and fill in
# your own EmailJS credentials from https://dashboard.emailjs.com/admin
#
# Service ID:  Email Services tab
# Template ID: Email Templates tab — the template should expect these
#              variables: from_name, from_email, subject, message
# Public Key:  Account > General

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
